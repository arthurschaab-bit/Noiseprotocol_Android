<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Wiederaufnahme der Ueberwachung nach Neustart (Plan Abschnitt 5.4). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Ehrlich abgefragt in den Einstellungen, nicht automatisch erzwungen (Plan 5.4): ohne
         Ausnahme drosseln Hersteller-ROMs den Foreground Service aggressiv. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Legacy-Bluetooth-Berechtigungen für Android 10/11 (API 29/30, z.B. Huawei P30) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Ab Android 12 (API 31+) moderne Bluetooth-Berechtigungen -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- M5: ntfy-Push und das Lebenszeichen der Totmannschaltung sind HTTP-Aufrufe. Ohne diese
         Berechtigung scheitert jeder Versand still - die App wuerde melden, dass sie alarmiert
         hat, und es waere nie etwas rausgegangen. -->
    <!-- M11 Etappe B: Videobeweis ueber CameraX. Die Aufnahme laeuft bewusst OHNE Tonspur
         (kein withAudioEnabled()), damit die Kamera das Mikrofon nicht anfasst und die
         Pegelmessung waehrend der Aufnahme durchlaeuft - der Ton wird nachtraeglich aus dem
         laufenden AudioRecord einmultiplext. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false": Sonst verschwindet die App im Play Store fuer jedes Geraet ohne
         Kamera, obwohl sie dort ihre Kernaufgabe - das Messen - voll erfuellt. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- M5: Die Karenzzeit laeuft ueber setExactAndAllowWhileIdle(). USE_EXACT_ALARM wird
         bewusst NICHT verwendet - die ist Kalender- und Weckerapps vorbehalten. Ohne die
         Genehmigung faellt der Alarm auf einen ungenauen zurueck, und der Einstellungsbildschirm
         zeigt das an, statt es zu verschweigen. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".LaermprotokollApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Laermprotokoll">

        <!-- Sentry: Automatische Initialisierung deaktivieren, da LaermprotokollApp Sentry manuell initialisiert -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- M5: Weckruf fuer Karenzzeit und Eskalation. Nicht exportiert - die Action ist
             app-intern, niemand von aussen soll einen Alarm ausloesen oder unterdruecken
             koennen. -->
        <receiver
            android:name=".alert.AlarmDeadlineReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.lrmprotokoll.ALARM_DEADLINE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".alert.local.AlarmDismissReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.lrmprotokoll.ACTION_STOP_ALARM" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".audio.AudioRecordingService"
            android:foregroundServiceType="microphone|connectedDevice"
            android:exported="false" />

        <!-- F14: Quick Settings Tile -->
        <service
            android:name=".service.NoiseMonitoringTileService"
            android:label="@string/app_name"
            android:icon="@drawable/ic_qs_noise"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- exported=true ist hier vertretbar: BOOT_COMPLETED ist ein geschuetzter
             Systembroadcast, den keine App faelschen kann. -->
        <receiver
            android:name=".audio.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- F14: Homescreen-Widget. exported=false wie bei AlarmDeadlineReceiver/
             AlarmDismissReceiver oben: der System-Widgethost darf trotzdem aktualisieren
             ("privileged system components" sind von exported=false ausgenommen), aber keine
             fremde App kann die ACTION_TOGGLE-Aktion faelschen und die Ueberwachung fernsteuern. -->
        <receiver
            android:name=".widget.NoiseMonitoringWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/noise_monitoring_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.lrmprotokoll.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
