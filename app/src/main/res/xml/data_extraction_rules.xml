<?xml version="1.0" encoding="utf-8"?><!--
   Wird bei android:allowBackup="false" ignoriert. Als Absicherung fuer den Fall belassen,
   dass Backup spaeter wieder aktiviert wird: Aufnahmen (external), Messdatenbank (database)
   und Einstellungen (sharedpref - seit M6 auch die verschluesselte ntfy-Konfiguration)
   duerfen nicht ueber Cloud-Backup oder Geraetewechsel abfliessen.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
