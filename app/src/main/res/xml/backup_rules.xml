<?xml version="1.0" encoding="utf-8"?><!--
   Wird bei android:allowBackup="false" ignoriert. Als Absicherung fuer den Fall belassen,
   dass Backup spaeter wieder aktiviert wird: Aufnahmen (external), Messdatenbank (database)
   und Einstellungen (sharedpref - seit M6 auch die verschluesselte ntfy-Konfiguration)
   duerfen nicht ueber Auto-Backup abfliessen.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="external" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
